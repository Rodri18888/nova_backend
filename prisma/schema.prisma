generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String         @id @default(cuid())
  username             String         @unique
  email                String         @unique
  password             String
  nombre               String
  rol                  String         @default("vendedor") // admin, vendedor
  activo               Boolean        @default(true)
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  sales                Sale[]
  devoluciones         Devolution[]
  cashRegisters        CashRegister[]
  cashMovements        CashMovement[]
  storeId              String
  store                Store @relation(fields: [storeId], references: [id])

}


model Product {
  id                 String              @id @default(cuid())
  name               String
  description        String?
  sku                String
  barcode            String?
  price              Decimal             @db.Decimal(12, 2)
  cost               Decimal             @db.Decimal(12, 2)
  stock              Int                 @default(0)
  minStock           Int                 @default(5)
  size               String[]
  color              String[]
  material           String[]
  type               String?
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  saleItems          SaleItem[]
  devolutionItems    DevolutionItem[]
  purchaseItems      PurchaseItem[]
  inventoryMovements InventoryMovement[]
  storeId            String
  store              Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, sku])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  points    Int      @default(0)
  sales     Sale[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  storeId   String
  store     Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, email])
}

model Sale {
  id              String       @id @default(cuid())
  invoice         String
  total           Decimal      @db.Decimal(12, 2)
  subtotal        Decimal      @db.Decimal(12, 2)
  tax             Decimal      @db.Decimal(12, 2)
  discount        Decimal      @default(0) @db.Decimal(12, 2)
  paymentMethod   String
  customerId      String?
  customer        Customer?    @relation(fields: [customerId], references: [id])
  userId          String?
  user            User?        @relation(fields: [userId], references: [id])
  status          String       @default("activa") // activa, anulada
  motivoAnulacion String?
  items           SaleItem[]
  devoluciones    Devolution[]
  createdAt       DateTime     @default(now())
  storeId         String
  store           Store @relation(fields: [storeId], references: [id])
  stripePaymentIntentId String?  @unique
  stripeRefundId        String?

  @@unique([storeId, invoice])
}

model SaleItem {
  id        String  @id @default(cuid())
  quantity  Int
  price     Decimal @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  storeId   String
  store     Store @relation(fields: [storeId], references: [id])
}

model Devolution {
  id        String           @id @default(cuid())
  invoice   String
  saleId    String
  sale      Sale             @relation(fields: [saleId], references: [id])
  total     Decimal          @db.Decimal(12, 2)
  motivo    String
  userId    String?
  user      User?            @relation(fields: [userId], references: [id])
  items     DevolutionItem[]
  createdAt DateTime         @default(now())
  storeId   String
  store     Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, invoice])
}

model DevolutionItem {
  id           String     @id @default(cuid())
  devolutionId String
  devolution   Devolution @relation(fields: [devolutionId], references: [id])
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  quantity     Int
  price        Decimal    @db.Decimal(12, 2)
  subtotal     Decimal    @db.Decimal(12, 2)
  motivo       String
  storeId      String
  store        Store @relation(fields: [storeId], references: [id])
}

model Supplier {
  id        String     @id @default(cuid())
  name      String
  contact   String?
  phone     String?
  email     String?
  address   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  purchases Purchase[]
  storeId   String
  store     Store @relation(fields: [storeId], references: [id])
}

model Purchase {
  id         String         @id @default(cuid())
  invoice    String
  supplierId String?
  supplier   Supplier?      @relation(fields: [supplierId], references: [id])
  total      Decimal        @db.Decimal(12, 2)
  status     String         @default("pendiente") // pendiente, pagado
  items      PurchaseItem[]
  createdAt  DateTime       @default(now())
  storeId    String
  store      Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, invoice])
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  price      Decimal  @db.Decimal(12, 2)
  subtotal   Decimal  @db.Decimal(12, 2)
  storeId    String
  store      Store @relation(fields: [storeId], references: [id])
}

model CashRegister {
  id             String         @id @default(cuid())
  openDate       DateTime       @default(now())
  closeDate      DateTime?
  initialAmount  Decimal        @db.Decimal(12, 2)
  expectedAmount Decimal?       @db.Decimal(12, 2)
  realAmount     Decimal?       @db.Decimal(12, 2)
  totalSales     Decimal        @default(0) @db.Decimal(12, 2)
  totalReturns   Decimal        @default(0) @db.Decimal(12, 2)
  status         String         @default("abierta") // abierta, cerrada
  userId         String?
  user           User?          @relation(fields: [userId], references: [id])
  movements      CashMovement[]
  createdAt      DateTime       @default(now())
  storeId        String
  store          Store          @relation(fields: [storeId], references: [id])
}

model CashMovement {
  id             String       @id @default(cuid())
  cashRegisterId String
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id])
  type           String       // entrada, salida
  amount         Decimal      @db.Decimal(12, 2)
  reason         String
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  createdAt      DateTime     @default(now())
  storeId        String
  store          Store        @relation(fields: [storeId], references: [id])
}

model InventoryMovement {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  type      String   // entrada, salida
  quantity  Int
  reason    String
  createdAt DateTime @default(now())
  storeId   String
  store     Store @relation(fields: [storeId], references: [id])
}

model Store {
  id                 String @id @default(cuid())
  code               String @unique
  name               String
  users              User[]
  products           Product[]
  customers          Customer[]
  sales              Sale[]
  saleItems          SaleItem[]
  devoluciones       Devolution[]
  devolutionItems    DevolutionItem[]
  suppliers          Supplier[]
  purchases          Purchase[]
  purchaseItems      PurchaseItem[]
  cashRegisters      CashRegister[]
  cashMovements      CashMovement[]
  inventoryMovements InventoryMovement[]
}